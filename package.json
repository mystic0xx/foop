{
  "name": "foop",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "pnpm --filter @foop/core build && pnpm --filter @foop/cli build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @foop/core typecheck && pnpm --filter @foop/cli typecheck"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9"
}
